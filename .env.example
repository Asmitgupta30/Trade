# Optional LLM API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Port (default: 8000)
PORT=8000

# Optional Angel One SmartAPI credentials (free real-time WebSocket market feed)
# If omitted, system defaults to free real-market Yahoo Finance + NSE Bhavcopy
ANGEL_API_KEY=your_smartapi_api_key
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PASSWORD=your_mpin_or_password
ANGEL_TOTP_SECRET=your_totp_qr_secret